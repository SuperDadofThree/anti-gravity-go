<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glowing orbital ellipse -->
    <path
        android:pathData="M30,62 C30,48 78,48 78,62 C78,76 30,76 30,62 Z"
        android:strokeWidth="3"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="55"
                android:endX="78"
                android:endY="69"
                android:type="linear">
                <item android:offset="0.0" android:color="#24D6F4" />
                <item android:offset="1.0" android:color="#A87FFB" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Levitating upward Chevron / Zero-G Pyramid -->
    <path
        android:pathData="M54,26 L76,64 L54,56 L32,64 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="26"
                android:endX="54"
                android:endY="64"
                android:type="linear">
                <item android:offset="0.0" android:color="#8AB4F8" />
                <item android:offset="0.5" android:color="#4285F4" />
                <item android:offset="1.0" android:color="#1A73E8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center core crystal / zero-gravity sphere -->
    <path
        android:pathData="M54,68 A5,5 0 1 0 54,78 A5,5 0 1 0 54,68"
        android:fillColor="#24D6F4" />
</vector>